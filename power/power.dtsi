#include <dt-bindings/leds/common.h>

&spmi_bus {
	pmic@2 {
		battery@4000 {
			compatible = "huawei,dby-w09-fg";
			reg = <0x4000>;
			huawei,service-charger-watchdog;
		};
	};
};

&pm8150l_lpg {
	status = "okay";
	led@1 {
		reg = <1>;
		color = <LED_COLOR_ID_RED>;
		function = LED_FUNCTION_STATUS;
		label = "red";
		default-state = "off";
	};
	led@2 {
		reg = <2>;
		color = <LED_COLOR_ID_GREEN>;
		function = LED_FUNCTION_STATUS;
		label = "green";
		default-state = "off";
	};
	led@3 {
		reg = <3>;
		color = <LED_COLOR_ID_BLUE>;
		function = LED_FUNCTION_STATUS;
		label = "blue";
		default-state = "off";
	};
};

/* Rear camera flash: one white LED on channel 1 of the PM8150L flash block
 * (stock: torch_0/flash_0 behind switch_0, 300 mA torch, 1 A flash, 1.28 s). */
&pm8150l_flash {
	status = "okay";
	led-0 {
		function = LED_FUNCTION_FLASH;
		color = <LED_COLOR_ID_WHITE>;
		led-sources = <1>;
		led-max-microamp = <300000>;
		flash-max-microamp = <1000000>;
		flash-max-timeout-us = <1280000>;
	};
};
