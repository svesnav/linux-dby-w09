#include <dt-bindings/leds/common.h>

&spmi_bus {
	pmic@2 {
		battery@4000 {
			compatible = "huawei,dby-w09-fg";
			reg = <0x4000>;
			huawei,service-charger-watchdog;
		};
	};
};

&pm8150l_lpg {
	status = "okay";
	led@1 {
		reg = <1>;
		color = <LED_COLOR_ID_RED>;
		function = LED_FUNCTION_STATUS;
		label = "red";
		default-state = "off";
	};
	led@2 {
		reg = <2>;
		color = <LED_COLOR_ID_GREEN>;
		function = LED_FUNCTION_STATUS;
		label = "green";
		default-state = "off";
	};
	led@3 {
		reg = <3>;
		color = <LED_COLOR_ID_BLUE>;
		function = LED_FUNCTION_STATUS;
		label = "blue";
		default-state = "off";
	};
};
